      "snippet": "Austin Location: Original spot on North Lamar Boulevard."
     },
     {
      "snippet": "Cedar Park Location: Second spot on Whitestone Boulevard."
     },
     {
      "snippet": "Hours: Open daily from 11:00 AM to 8:00 PM (closed Mondays)."
     }
    ]
   },
   {
    "type": "heading",
    "snippet": "Menu and Pricing"
   },
   {
    "type": "list",
    "list": [
     {
      "snippet": "Brisket: Around $19.00 per half-pound."
     },
     {
      "snippet": "Smoked Turkey or Pork Belly Burnt Ends: Around $15.00 per half-pound."
     },
     {
      "snippet": "Sausage Links: $6.50 to $7.50 per link."
     },
     {
      "snippet": "Sides & Desserts: Famous for corn casserole, potato salad, and house-made desserts like peach cobbler and banana pudding."
     }
    ]
   },
